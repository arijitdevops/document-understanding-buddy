# ---------------------------------------------------------------------------
# Document Understanding Buddy -- configuration
# Copy to .env (in the repository root) and fill in GEMINI_API_KEY.
# The backend reads ./.env and ../.env, so running it from backend/ picks this up.
# ---------------------------------------------------------------------------

# Required: Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models (override when Google renames or retires models)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# MySQL (matches the mysql service in docker-compose.yml)
DATABASE_URL=mysql+asyncmy://doc_buddy:doc_buddy@localhost:3306/doc_buddy
AUTO_CREATE_TABLES=true
# Quick local run without MySQL:
# DATABASE_URL=sqlite+aiosqlite:///./data/doc_buddy.db

# Local storage (relative paths are resolved against backend/)
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Chunking and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=30
HYBRID_ENABLED=true
HYBRID_ALPHA=0.5
RERANK_ENABLED=false
HISTORY_MESSAGES=6
DOCUMENT_TASK_MAX_CHARS=60000

# HTTP
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
ENVIRONMENT=development

# docker compose only
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=doc_buddy
